<%- include('../partials/head') %>
<%- include('../partials/header', { bodyClass: 'page-category' }) %>
<% const it = d.intro || {}; %>
<section class="pagehead">
  <div class="wrap">
    <%- include('../partials/crumbs', { crumbs: [{ label: page.title }] }) %>
    <h1 class="pagehead__title"><%= it.title || page.title %></h1>
    <% if (it.text) { %><p class="pagehead__lead"><%= it.text %></p><% } %>
  </div>
</section>
<section class="sec sec--tight">
  <div class="wrap">
    <% if (products.length) { %>
      <div class="pgrid pgrid--2"><% for (const p of products) { %><%- include('../partials/product-card', { p, showFeatures: true }) %><% } %></div>
    <% } else { %><p>Bu kategoride henüz ürün yok.</p><% } %>
  </div>
</section>
<%- include('../partials/footer') %>
