<%- include('../partials/head') %>
<%- include('../partials/header', { bodyClass: 'page-blog' }) %>
<% const it = d.intro || {}; %>
<section class="pagehead">
  <div class="wrap">
    <%- include('../partials/crumbs', { crumbs: active ? [{ label: 'Blog', url: '/blog' }, { label: active.name }] : [{ label: 'Blog' }] }) %>
    <h1 class="pagehead__title"><%= active ? active.name : (it.title || 'Blog') %></h1>
    <% if (active ? active.description : it.text) { %><p class="pagehead__lead"><%= active ? active.description : it.text %></p><% } %>
    <% if (cats.length > 1) { %>
    <nav class="chips" aria-label="Kategoriler">
      <a href="/blog"<%- !active ? ' aria-current="page"' : '' %>>Tümü</a>
      <% for (const c of cats) { %><a href="/blog?kategori=<%= c.slug %>"<%- active && active.id === c.id ? ' aria-current="page"' : '' %>><%= c.name %></a><% } %>
    </nav>
    <% } %>
  </div>
</section>
<section class="sec sec--tight">
  <div class="wrap">
    <% if (!posts.length) { %><p>Henüz yazı yayınlanmadı.</p><% } %>
    <div class="postlist">
      <% for (const p of posts) { %>
      <article class="postrow">
        <% if (p.cover) { %><div class="postrow__media"><%- img(p.cover, { alt: '', sizes: '260px' }) %></div><% } %>
        <div>
          <p class="postrow__meta"><time datetime="<%= String(p.published_at).slice(0,10) %>"><%= dateTR(p.published_at) %></time><% if (p.cat_name) { %> · <%= p.cat_name %><% } %></p>
          <h2 class="postrow__title"><a href="/<%= p.slug %>"><%= p.title %></a></h2>
          <% if (p.excerpt) { %><p><%= clip(p.excerpt, 220) %></p><% } %>
        </div>
      </article>
      <% } %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
