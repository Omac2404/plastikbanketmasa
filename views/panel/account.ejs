<%- include('_top') %>
<div class="pagehead"><div><h1 class="h1">Hesabım</h1><p class="muted"><%= user.email %> · <%= ROLES[user.role].label %></p></div></div>
<form method="post" class="card narrow stack" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field"><label class="label" for="an">Adınız</label><input id="an" name="name" value="<%= user.name %>"></div>
  <h2 class="h3">Parola değiştirin</h2>
  <div class="field"><label class="label" for="cp">Mevcut parola</label><input id="cp" name="current_password" type="password" autocomplete="current-password"></div>
  <div class="field"><label class="label" for="np">Yeni parola</label><input id="np" name="new_password" type="password" autocomplete="new-password" minlength="8"><p class="hint">En az 8 karakter. Değiştirince diğer cihazlardaki oturumlarınız kapanır.</p></div>
  <div class="field"><label class="label" for="np2">Yeni parola (tekrar)</label><input id="np2" name="new_password2" type="password" autocomplete="new-password"></div>
  <button class="btn btn--primary">Kaydedin</button>
</form>
<%- include('_bottom') %>
